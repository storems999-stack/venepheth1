# =============================================================================
# Venepheth SAYAVONG Academic Platform — Production Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.prod.example .env.prod
#   2. Fill in every value
#   3. NEVER commit .env.prod to version control
# =============================================================================

# ─── Django Core ─────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
# Use a URL-safe value; Compose expands '$' in env files.
SECRET_KEY=use_a_50+_char_random_string_from_a_secure_generator
DEBUG=False
ALLOWED_HOSTS=venepheth.online,www.venepheth.online
CSRF_TRUSTED_ORIGINS=https://venepheth.online,https://www.venepheth.online
ADMIN_URL=secure-admin/

# ─── Database (PostgreSQL) ────────────────────────────────────────────
POSTGRES_DB=venepheth_db
POSTGRES_USER=venepheth_user
POSTGRES_PASSWORD=use_a_strong_db_password_min_32_chars
DATABASE_URL=postgres://venepheth_user:use_a_strong_db_password_min_32_chars@db:5432/venepheth_db

# ─── Redis (Cache & Celery Broker) ────────────────────────────────────
REDIS_PASSWORD=use_a_strong_redis_password_min_32_chars
# Keep this password identical to REDIS_PASSWORD; percent-encode reserved URL characters.
REDIS_URL=redis://:use_a_strong_redis_password_min_32_chars@redis:6379/0

# ─── Email (SMTP) ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your_email@example.com
EMAIL_HOST_PASSWORD=your_app_specific_password
DEFAULT_FROM_EMAIL=Dr. Venepheth SAYAVONG <noreply@yourdomain.com>

# ─── Storage ──────────────────────────────────────────────────────────
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles
SENDFILE_ENABLED=True

# ─── Security ─────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Metrics ──────────────────────────────────────────────────────────
METRICS_TOKEN=use_a_long_random_string_min_32_chars
METRICS_REQUIRE_TOKEN=True

# ─── Backup Encryption ────────────────────────────────────────────────
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=use_a_fernet_encryption_key_min_32_chars

# ─── Off-site Backup Storage (Cloudflare R2, S3-compatible) ───────────
# Create a private R2 bucket and an API token limited to this bucket.
# Configure its 365-day lifecycle rule with deploy/r2-backup-lifecycle-365d.json.
S3_BACKUP_BUCKET=
S3_BACKUP_PREFIX=venepheth/production
S3_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com
AWS_DEFAULT_REGION=auto
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ─── Domain ───────────────────────────────────────────────────────────
DOMAIN=venepheth.online

# ─── Trusted Proxies (the Nginx address on the isolated tunnel network) ─
TRUSTED_PROXY_IPS=172.29.0.2
TUNNEL_ORIGIN_PORT=8081
