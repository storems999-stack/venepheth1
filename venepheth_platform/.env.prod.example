# =============================================================================
# Venepheth SAYAVONG Academic Platform — Production Environment Variables
# =============================================================================
# INSTRUCTIONS:
#   1. Copy this file: cp .env.prod.example .env.prod
#   2. Fill in every value marked with <CHANGE_ME>
#   3. NEVER commit .env.prod to version control
# =============================================================================

# ─── Django Core ─────────────────────────────────────────────────────────────
DJANGO_SETTINGS_MODULE=config.settings.production
SECRET_KEY=<CHANGE_ME_use_a_50+_char_random_string>
DEBUG=False
ALLOWED_HOSTS=yourdomain.com,www.yourdomain.com
ADMIN_URL=<CHANGE_ME_secret_admin_path>/

# ─── Database (PostgreSQL) ────────────────────────────────────────────────────
POSTGRES_DB=venepheth_db
POSTGRES_USER=venepheth_user
POSTGRES_PASSWORD=<CHANGE_ME_strong_db_password>
DATABASE_URL=postgres://venepheth_user:<CHANGE_ME_strong_db_password>@db:5432/venepheth_db

# ─── Redis (Cache & Celery Broker) ───────────────────────────────────────────
REDIS_URL=redis://redis:6379/0

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=<CHANGE_ME_your_email@gmail.com>
EMAIL_HOST_PASSWORD=<CHANGE_ME_app_password>
DEFAULT_FROM_EMAIL=Dr. Venepheth SAYAVONG <noreply@yourdomain.com>

# ─── Storage ──────────────────────────────────────────────────────────────────
# For local storage (default):
MEDIA_ROOT=/app/media
STATIC_ROOT=/app/staticfiles

# ─── Security ────────────────────────────────────────────────────────────────
SECURE_SSL_REDIRECT=True
SESSION_COOKIE_SECURE=True
CSRF_COOKIE_SECURE=True

# ─── Metrics (required — Prometheus scrapes /metrics/ with this token) ───────
METRICS_TOKEN=<CHANGE_ME_long_random_string_for_metrics>

# ─── Domain ───────────────────────────────────────────────────────────────────
DOMAIN=yourdomain.com
