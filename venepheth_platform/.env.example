# ─── Core ─────────────────────────────────────────────────────
SECRET_KEY=use_a_50+_char_random_string_from_a_secure_generator
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ──────────────────────────────────────────────────
DATABASE_URL=postgresql://venepheth_app:use_a_strong_db_password_min_32_chars@db:5432/venepheth_db
POSTGRES_DB=venepheth_db
POSTGRES_USER=venepheth_app
POSTGRES_PASSWORD=use_a_strong_db_password_min_32_chars

# ─── Redis ─────────────────────────────────────────────────────
REDIS_URL=redis://:use_redis_password@redis:6379/0
REDIS_PASSWORD=use_a_strong_redis_password_min_32_chars

# ─── Email ─────────────────────────────────────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@venepheth.edu.la

# ─── Admin URL ─────────────────────────────────────────────────
ADMIN_URL=secure-admin/

# ─── CSRF Trusted Origins ──────────────────────────────────────
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Trusted Proxies ──────────────────────────────────────────
# TRUSTED_PROXY_IPS=127.0.0.1,172.18.0.0/16

# ─── Metrics ──────────────────────────────────────────────────
# METRICS_TOKEN=use_a_long_random_string_min_32_chars
# METRICS_REQUIRE_TOKEN=False

# ─── Backup Encryption ────────────────────────────────────────
# Generate key: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# BACKUP_ENCRYPTION_KEY=use_a_fernet_encryption_key_min_32_chars

# ─── AI Assistant (optional) ──────────────────────────────────
# Google Gemini key for AI answers. Empty = free local engine.
# Get a key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_key_here

# ─── Sentry (optional) ────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ─── Storage (future S3/R2 support) ───────────────────────────
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
