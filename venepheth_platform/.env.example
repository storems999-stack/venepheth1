# ─── Core ──────────────────────────────────────────────────────────────────────
SECRET_KEY=your-secret-key-change-this-in-production-use-long-random-string

DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0

# ─── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://venepheth_app:change_me_in_env@db:5432/venepheth_db

POSTGRES_DB=venepheth_db
POSTGRES_USER=venepheth_app
POSTGRES_PASSWORD=change_me_in_env

# ─── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://:change_me_in_env@redis:6379/0
REDIS_PASSWORD=change_me_in_env

# ─── Email (development — uses console backend by default) ────────────────────
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
DEFAULT_FROM_EMAIL=noreply@venepheth.edu.la
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_HOST_USER=your@gmail.com
# EMAIL_HOST_PASSWORD=your-app-password

# ─── Admin URL (change this in production!) ────────────────────────────────────
ADMIN_URL=secure-admin/

# ─── CSRF Trusted Origins (add your domain in production) ─────────────────────
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1

# ─── Metrics (optional — required in production) ────────────────────────────
# METRICS_TOKEN=change-me-long-random-string

# ─── Sentry (optional) ────────────────────────────────────────────────────────
# SENTRY_DSN=https://...@sentry.io/...

# ─── Storage (future S3/R2 support) ───────────────────────────────────────────
# DEFAULT_FILE_STORAGE=storages.backends.s3boto3.S3Boto3Storage
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
# AWS_S3_ENDPOINT_URL=
